  'sky-rush': { title:'SKY RUSH', cat:'Arcade', rating:4.7, desc:'An original futuristic arcade flight game — fly through energy rings, dodge obstacles and survive rising levels.', how:'Fly through every golden energy ring to score and reach the level target before time runs out. Each level adds more obstacles and raises the ring target. One collision ends the flight.', controls:['Arrow keys / WASD — steer up, down, left & right','R — restart flight','P — pause','On-screen buttons — mobile controls'] },
  'poly-rush': { title:'POLY RUSH', cat:'Racing', rating:4.8, desc:'A brand-new low-poly arcade racer — carve neon corners, hit ramps and beat your lap records.', how:'Complete 3 laps around the neon circuit. Pass every checkpoint in order, hit glowing ramps for a boost, and avoid barriers — one crash sends you back to the last checkpoint. Off-track surfaces slow you down, so stay on the asphalt!', controls:['Arrow keys / WASD — steer & accelerate','Space — handbrake (tight turns)','R — restart race','P — pause','On-screen buttons — mobile controls'] },
  'neon-serpent': { title:'NEON SERPENT', cat:'Arcade', rating:4.9, desc:'Control a glowing serpent, collect energy and survive as long as possible.', how:'Steer the serpent with arrow keys / WASD, swipe on mobile or use the touch pad. Collect glowing cells for +10 points. Every 5 cells speeds the game up. Hitting a wall or your own tail ends the run.', controls:['Arrow keys / WASD — steer the serpent','P — pause / resume','On-screen D-pad or swipe — mobile controls'] }
};
const THUMBS = {}; // filled below with svg strings reused from cards
document.querySelectorAll('.game-card > a svg').forEach(svg => {
  const id = svg.closest('.game-card').querySelector('.fav-toggle').dataset.id;
  THUMBS[id] = svg.outerHTML;
});

/* ============ Mobile menu ============ */
const menuBtn = document.getElementById('menuBtn'), mobileMenu = document.getElementById('mobileMenu');
menuBtn.addEventListener('click', () => {
  const open = mobileMenu.classList.toggle('hidden') === false;
  menuBtn.setAttribute('aria-expanded', open);
});
mobileMenu.addEventListener('click', e => { if (e.target.closest('a')) { mobileMenu.classList.add('hidden'); menuBtn.setAttribute('aria-expanded','false'); } });

/* ============ Direct router (geen hash afhankelijkheid) ============ */
const pages = ['home','games','game','play','favorites','leaderboard','profile','about','settings'];
let currentPage = 'home';
function go(name, param){
  try { stopGame(); } catch(err){ console.error('stopGame error:', err); }

  if (name === 'game' && param && GAMES[param]) {
    try { fillDetail(param); } catch(err){ console.error('fillDetail error:', err); }
    show('game');
  } else if (name === 'play' && param && GAMES[param]) {
    show('play');
    try { launchGame(param); } catch(err){ console.error('launchGame error:', err); }
  } else if (name === 'privacy' || name === 'terms') {
    show('about');
  } else if (pages.includes(name)) {
    show(name);
    try {
      if(name==='favorites') renderFavs();
      if(name==='leaderboard') renderLB();
      if(name==='profile') renderProfile();
    } catch(err){ console.error('render error for', name, err); }
  } else {
    show('home');
  }
  currentPage = name;
  window.scrollTo({top:0});
}
function show(name){
  pages.forEach(p => document.getElementById('page-'+p)?.classList.add('hidden'));
  const el = document.getElementById('page-'+name);
  el.classList.remove('hidden'); el.classList.add('active');
  // sync active state on nav links
  const navName = ['game','play'].includes(name) ? 'games' : (['privacy','terms'].includes(name) ? 'about' : name);
  document.querySelectorAll('.nav-link').forEach(a => {
    const target = (a.getAttribute('href')||'').replace('#/','');
    a.classList.toggle('text-cyan-400', target === navName);
    a.classList.toggle('text-slate-300', target !== navName);
  });
}
/* Game card & play links: single authoritative direct-DOM navigation (capture phase).
   Guarantees every existing game card, the detail PLAY button and the detail
   FULLSCREEN flow work without relying on hash navigation at all. */
document.addEventListener('click', e => {
  const a = e.target.closest('a[href^="#/game/"], a[href^="#/play/"]');
  if (!a || a.target === '_blank') return;
  e.preventDefault();
  e.stopImmediatePropagation();
  const [, kind, id] = a.getAttribute('href').split('/');
  try {
    if (kind === 'game' && GAMES[id]) {
      try { stopGame(); } catch(err){}
      try { fillDetail(id); } catch(err){ console.error('fillDetail error:', err); }
      show('game');
      currentPage = 'game';
    } else if (kind === 'play' && GAMES[id]) {
      show('play');
      currentPage = 'play';
      try { launchGame(id); } catch(err){ console.error('launchGame error:', err); }
    } else {
      show('games');
      currentPage = 'games';
      return;
    }
    window.scrollTo({top:0});
  } catch(err){ console.error('game card navigation error:', err); }
}, true);

/* Alle interne links: #/games → go('games'), #/play/neon-serpent → go('play','neon-serpent') */
document.addEventListener('click', e => {
  const a = e.target.closest('a[href^="#/"]');
  if (!a || a.target === '_blank') return;
  e.preventDefault();
  const parts = a.getAttribute('href').replace('#/','').split('/');
  try { go(parts[0], parts[1]); } catch(err) { console.error('navigation error:', err); }
  // mobiel menu dichtklappen na navigatie
  mobileMenu.classList.add('hidden');
  menuBtn.setAttribute('aria-expanded','false');
});

/* ============ Game detail ============ */
function fillDetail(id){
  const g = GAMES[id];
  document.getElementById('detailThumb').innerHTML = THUMBS[id] || '';
  document.getElementById('detailTitle').textContent = g.title;
  document.getElementById('detailCat').textContent = g.cat.toUpperCase();
  document.getElementById('detailRating').textContent = '★ ' + g.rating.toFixed(1);
  document.getElementById('detailDesc').textContent = g.desc;
  document.getElementById('detailHow').textContent = g.how;
  const ctrl = g.controls || ['Keyboard — gameplay controls','Mouse / touch — where supported','P — pause'];
  document.getElementById('detailControls').innerHTML = ctrl.map(c => `<li class="flex gap-3"><span class="text-cyan-400 font-bold">▸</span>${c}</li>`).join('');
  document.getElementById('detailPlay').setAttribute('href', '#/play/'+id);
  document.querySelector('#page-game .fav-toggle').dataset.id = id;
  currentDetailId = id;
  renderVotes();
  syncHearts();
}

/* ============ Game detail: like / dislike + fullscreen play ============ */
let currentDetailId = 'neon-serpent';
const DEFAULT_VOTES = 18;
function votesFor(id){
  const votes = store.get('votes', {});
  if (!votes[id]) { votes[id] = { u: DEFAULT_VOTES + (id.length % 7), d: 1 + (id.length % 3) }; store.set('votes', votes); }
  return votes[id];
}
function renderVotes(){
  const v = votesFor(currentDetailId);
  const my = (store.get('myvote', {})[currentDetailId]) || 0;
  document.getElementById('likeCount').textContent = v.u;
  document.getElementById('dislikeCount').textContent = v.d;
  const on = 'flex-1 flex items-center justify-center gap-1.5 border rounded-xl py-2.5 font-semibold transition border-emerald-500 text-emerald-300 bg-emerald-500/10';
  const onD = 'flex-1 flex items-center justify-center gap-1.5 border rounded-xl py-2.5 font-semibold transition border-rose-500 text-rose-300 bg-rose-500/10';
  const off = 'flex-1 flex items-center justify-center gap-1.5 border rounded-xl py-2.5 font-semibold transition border-slate-600 text-slate-300 ';
  document.getElementById('likeBtn').className = my===1 ? on : off + 'hover:border-emerald-500';
  document.getElementById('dislikeBtn').className = my===-1 ? onD : off + 'hover:border-rose-500';
}
document.getElementById('likeBtn').addEventListener('click', () => {
  const votes = store.get('votes', {}), myvote = store.get('myvote', {});
  const v = votesFor(currentDetailId), my = myvote[currentDetailId] || 0;
  if (my === 1){ v.u--; myvote[currentDetailId] = 0; }
  else { if (my === -1) v.d--; v.u++; myvote[currentDetailId] = 1; }
  store.set('votes', votes); store.set('myvote', myvote); renderVotes();
});
document.getElementById('dislikeBtn').addEventListener('click', () => {
  const votes = store.get('votes', {}), myvote = store.get('myvote', {});
  const v = votesFor(currentDetailId), my = myvote[currentDetailId] || 0;
  if (my === -1){ v.d--; myvote[currentDetailId] = 0; }
  else { if (my === 1) v.u--; v.d++; myvote[currentDetailId] = -1; }
  store.set('votes', votes); store.set('myvote', myvote); renderVotes();
});
