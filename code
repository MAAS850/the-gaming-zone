  'craftverse': { title:'CRAFTVERSE', cat:'Simulation / Adventure', rating:4.4, desc:'Collect resources, craft objects and build your own small world.', how:'Gather wood, stone and ore, combine them at the workbench and unlock blueprints to expand your tiny world.' },
  'cosmic-wave': { title:'COSMIC WAVE', cat:'Arcade', rating:4.8, desc:'Control a futuristic spacecraft and survive increasingly difficult waves of obstacles.', how:'Survive wave after wave of asteroid clusters. Difficulty ramps every 30 seconds — dodge or perish.' },
  'voxel-sandbox': { title:'VOXEL SANDBOX', cat:'Adventure / Sandbox', rating:4.7, desc:'An original block-building and exploration game — shape a voxel world of your own.', how:'Explore a generated voxel island: grassy hills, sandy shores, trees and glowing crystals. Mine any block, then build whatever you imagine with 8 original block types. Your world saves automatically on this device.', controls:['WASD / Arrow keys — move','Mouse (click game to lock) or drag — look around','Left click / MINE — remove the targeted block','Right click / PLACE — place the selected block','1–8 or hotbar — select block type','Space / JUMP — jump','P — pause'] },
