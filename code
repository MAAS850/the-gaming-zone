  'arcade-flight': { title:'ARCADE FLIGHT', cat:'Arcade', rating:4.6, desc:'An original fast flying game — thread obstacles and hit checkpoints at speed.', how:'Pilot a jet through canyon obstacles and pass glowing checkpoints before the timer runs out. Each checkpoint adds time and score.', controls:['Arrow keys / WASD — pitch & steer','Shift — boost','P — pause'] },
  'space-reflex': { title:'SPACE REFLEX', cat:'Arcade', rating:4.7, desc:'An original spaceship obstacle-dodging game — pure reflexes, pure speed.', how:'Steer your ship through an endless stream of asteroid fields. The longer you survive, the faster it gets. One hit ends the run.', controls:['Arrow keys / WASD or mouse — steer','Space — dash (brief invincibility)','P — pause'] },
  'precision-target': { title:'PRECISION TARGET', cat:'Casual', rating:4.5, desc:'An original arcade target game — accuracy scoring across timed rounds.', how:'Targets appear across the range for a limited time. Hit them dead-center for bonus accuracy points. Misses cost accuracy — 60 seconds per round.', controls:['Mouse — aim','Click — shoot','R — restart round'] },
