function NeonSerpent(){
  const CELL = 24, COLS = canvas.width/CELL, ROWS = canvas.height/CELL;
  let snake, dir, nextDir, food, score, speed, tick, alive, running = false;
  let high = store.get('scores',{})['neon-serpent'] || 0;
  setShell(0, high);

  function reset(){
    snake = [{x:8,y:12},{x:7,y:12},{x:6,y:12}];
    dir = {x:1,y:0}; nextDir = dir; score = 0; speed = 9; tick = 0; alive = true;
    placeFood(); setShell(0, high); draw();
  }
  function placeFood(){
    do { food = {x: Math.floor(Math.random()*COLS), y: Math.floor(Math.random()*ROWS)}; }
    while (snake.some(s => s.x===food.x && s.y===food.y));
  }
  function draw(){
    ctx.fillStyle = '#04070f'; ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.strokeStyle = 'rgba(34,211,238,0.07)'; ctx.lineWidth = 1;
    for(let i=1;i<COLS;i++){ ctx.beginPath(); ctx.moveTo(i*CELL,0); ctx.lineTo(i*CELL,canvas.height); ctx.stroke(); }
    for(let i=1;i<ROWS;i++){ ctx.beginPath(); ctx.moveTo(0,i*CELL); ctx.lineTo(canvas.width,i*CELL); ctx.stroke(); }
    // food
    ctx.shadowColor = '#f43f5e'; ctx.shadowBlur = 14;
    ctx.fillStyle = '#f43f5e'; ctx.beginPath(); ctx.arc(food.x*CELL+CELL/2, food.y*CELL+CELL/2, CELL/2-4, 0, 7); ctx.fill();
    // snake
    snake.forEach((s,i) => {
      ctx.shadowColor = '#22d3ee'; ctx.shadowBlur = i===0 ? 16 : 8;
      ctx.fillStyle = i===0 ? '#67e8f9' : `rgba(34,211,238,${Math.max(0.35, 1 - i/snake.length*0.6)})`;
      ctx.beginPath(); ctx.roundRect(s.x*CELL+2, s.y*CELL+2, CELL-4, CELL-4, 6); ctx.fill();
    });
    ctx.shadowBlur = 0;
    if (paused){ ctx.fillStyle='rgba(4,7,15,0.7)'; ctx.fillRect(0,0,canvas.width,canvas.height);
      ctx.fillStyle='#22d3ee'; ctx.font='900 40px Orbitron'; ctx.textAlign='center'; ctx.fillText('PAUSED', canvas.width/2, canvas.height/2); }
  }
  function step(){
    dir = nextDir;
    const head = {x: snake[0].x + dir.x, y: snake[0].y + dir.y};
    if (head.x<0 || head.y<0 || head.x>=COLS || head.y>=ROWS || snake.some(s=>s.x===head.x&&s.y===head.y)) return gameOver();
    snake.unshift(head);
    if (head.x===food.x && head.y===food.y){
      score += 10; setShell(score, high);
      if (score % 50 === 0) speed = Math.min(18, speed + 1);
      placeFood();
    } else snake.pop();
    draw();
  }
  function gameOver(){
    alive = false; running = false;
    grant('speed');
    if (score > 99) grant('highscore');
    if (score >= 100) grant('five');
    if (score > high){ high = score; const sc = store.get('scores',{}); sc['neon-serpent'] = score; store.set('scores', sc); setShell(score, high); }
    showOverlay('GAME OVER', `Final score: ${score} · High score: ${high}. One more run?`, 'PLAY AGAIN');
  }
  function loop(ts){
    if (!running) return;
    if (ts - tick > 1000/speed){ tick = ts; step(); }
    rafId = requestAnimationFrame(loop);
  }
  return {
    start(){ if (!alive) reset(); hideOverlay(); paused = false; running = true; rafId = requestAnimationFrame(loop); },
    restart(){ reset(); this.start(); },
    togglePause(){ if (!running && !paused) return; paused = !paused; if (paused){ draw(); } else { running = true; rafId = requestAnimationFrame(loop); } },
    setDir(d){ const m = {up:{x:0,y:-1},down:{x:0,y:1},left:{x:-1,y:0},right:{x:1,y:0}}[d]; if (m && !(m.x===-dir.x && m.y===-dir.y)) nextDir = m; },
    stop(){ running = false; },
    get running(){ return running; }
  };
}

/* ============ VOXEL SANDBOX engine (original raycast voxel renderer) ============ */
const BLOCKS = [null,
  {name:'GRASS',  col:[74,195,120]},
  {name:'DIRT',   col:[140,95,60]},
  {name:'STONE',  col:[122,132,148]},
  {name:'SAND',   col:[222,202,134]},
  {name:'WOOD',   col:[130,92,52]},
  {name:'LEAVES', col:[58,168,92]},
  {name:'CRYSTAL',col:[64,220,255]},
  {name:'BRICK',  col:[188,84,72]}
];
function hash2(x,z,s){ let h=(x*374761393 + z*668265263 + s*1442695041)|0; h=Math.imul(h^h>>>13,1274126177); return ((h^h>>>16)>>>0)/4294967296; }

function VoxelSandbox(){
  const S=32, MH=16, VW=360, VH=225;
  const oc=document.createElement('canvas'); oc.width=VW; oc.height=VH;
  const o=oc.getContext('2d');
  const world=new Uint8Array(S*S*MH);
  const idx=(x,y,z)=>(y*S+z)*S+x;
  function colH(x,z){ for(let y=MH-1;y>=0;y--) if(world[(y*S+z)*S+x]) return y+1; return 0; }
  let seed=(Math.random()*1e9)|0, sel=1, yaw=0, pitchS=0.12;
  let px=16.5, pz=16.5, py=8, vy=0, grounded=false;
  const keys={f:0,b:0,l:0,r:0};
  let running=false, pPaused=false, raf=null, lastT=0;

  /* hotbar */
  const hb=document.getElementById('voxelHotbar');
  hb.innerHTML = BLOCKS.slice(1).map((b,i)=>
    `<button data-b="${i+1}" title="${b.name} (key ${i+1})" aria-label="Select ${b.name}" class="vhot w-9 h-9 rounded-lg border-2 border-slate-600 text-[10px] font-bold text-void/70 transition" style="background:rgb(${b.col.join(',')})">${i+1}</button>`).join('');
  function setSel(n){ sel=n; hb.querySelectorAll('.vhot').forEach(b=>b.classList.toggle('border-cyan-400',+b.dataset.b===n)); }
  hb.onclick = e => { const b=e.target.closest('[data-b]'); if(b) setSel(+b.dataset.b); };
  setSel(1);

  /* world generation */
  function gen(s){
    world.fill(0); seed=s;
    const coarse=[]; for(let i=0;i<81;i++) coarse.push(hash2(i%9,(i/9)|0,s));
    const vn=(x,z)=>{ const gx=x/4,gz=z/4,x0=Math.min(7,gx|0),z0=Math.min(7,gz|0),fx=gx-x0,fz=gz-z0;
      const a=coarse[z0*9+x0],b=coarse[z0*9+x0+1],c=coarse[(z0+1)*9+x0],d=coarse[(z0+1)*9+x0+1];
      return (a*(1-fx)+b*fx)*(1-fz)+(c*(1-fx)+d*fx)*fz; };
    for(let x=0;x<S;x++)for(let z=0;z<S;z++){
      const h=3+Math.round(vn(x,z)*6);
      for(let y=0;y<h;y++){
        let t=3;
        if(y===h-1) t=h<=4?4:1; else if(y>=h-3) t=2;
        world[idx(x,y,z)]=t;
      }
      const r=hash2(x,z,s+77);
      if(r>0.982 && h>4 && x>0 && x<S-1 && z>0 && z<S-1){
        for(let y=h;y<h+3;y++) world[idx(x,y,z)]=5;
        for(let dx=-1;dx<=1;dx++)for(let dz=-1;dz<=1;dz++)for(let y=h+2;y<=h+3;y++){
          const nx=x+dx,nz=z+dz;
          if(nx>=0&&nz>=0&&nx<S&&nz<S&&world[idx(nx,y,nz)]===0) world[idx(nx,y,nz)]=6;
        }
      } else if(r<0.012 && h>3){ world[idx(x,h,z)]=7; }
    }
    spawn();
  }
  function spawn(){ px=16.5; pz=16.5; py=Math.max(1,colH(16,16)); vy=0; yaw=hash2(1,1,seed)*6.28; pitchS=0.12; updVec(); }

  /* persistence */
  function save(){ try{ store.set('voxel',{seed,data:Array.from(world).join('')}); }catch(e){} }
  function load(){
    const v=store.get('voxel',null);
    if(v && typeof v.data==='string' && v.data.length===S*S*MH){
      for(let i=0;i<world.length;i++) world[i]=+v.data[i]||0;
      seed=v.seed; spawn(); return true;
    }
    return false;
  }

  /* camera */
  const TANF=0.65, FOCAL=(VW/2)/TANF;
  let dirX=1,dirZ=0,plX=0,plZ=TANF;
  function updVec(){ dirX=Math.cos(yaw); dirZ=Math.sin(yaw); plX=-dirZ*TANF; plZ=dirX*TANF; }
  updVec();

  const skyC=[], gndC=[];
  for(let y=0;y<VH;y++){ const t=y/VH; skyC[y]=`rgb(${10+t*16|0},${15+t*24|0},${30+t*48|0})`; }

  function render(){
    const horizon=VH/2+pitchS*VH*0.9, eye=py+1.6;
    for(let y=0;y<VH;y++){ o.fillStyle=skyC[y]; o.fillRect(0,y,VW,1); }
    for(let y=0;y<VH;y++){
      const d=Math.max(0.5,y-horizon), dist=eye*FOCAL/d, f=Math.max(0,1-dist/34);
      gndC[y]=`rgb(${16+f*22|0},${24+f*26|0},${18+f*18|0})`;
    }
    for(let sx=0;sx<VW;sx++){
      const cx=2*sx/VW-1, rdx=dirX+plX*cx, rdz=dirZ+plZ*cx;
      let mx=px|0, mz=pz|0;
      const ddx=Math.abs(1/(rdx||1e-9)), ddz=Math.abs(1/(rdz||1e-9));
      let stX,stZ,sdx,sdz;
      if(rdx<0){stX=-1;sdx=(px-mx)*ddx;}else{stX=1;sdx=(mx+1-px)*ddx;}
      if(rdz<0){stZ=-1;sdz=(pz-mz)*ddz;}else{stZ=1;sdz=(mz+1-pz)*ddz;}
      let yb=VH, guard=0, done=false;
      while(!done && guard++<80){
        let side;
        if(sdx<sdz){ mx+=stX; sdx+=ddx; side=0; } else { mz+=stZ; sdz+=ddz; side=1; }
        if(mx<0||mz<0||mx>=S||mz>=S) break;
        const dist=side? sdz-ddz : sdx-ddx;
        const H=colH(mx,mz);
        if(H>0){
          if(eye+dist*pitchS < H){
            const yTop=Math.round(horizon-(H-eye)*FOCAL/Math.max(0.1,dist));
            if(yTop<yb){
              const t=world[((H-1)*S+mz)*S+mx]||3, c=BLOCKS[t].col;
              const sh=((1-Math.min(1,dist/34))*0.8+0.2)*(side?0.75:1);
              o.fillStyle=`rgb(${c[0]*sh|0},${c[1]*sh|0},${c[2]*sh|0})`;
              const y0=Math.max(0,yTop);
              o.fillRect(sx,y0,1,Math.min(VH,yb)-y0);
              yb=yTop;
            }
            done=true;
          }
        }
      }
      if(yb<VH){ const yr=Math.max(0,Math.min(VH-1,yb)); o.fillStyle=gndC[yr]; o.fillRect(sx,yb,1,VH-yb); }
    }
    o.strokeStyle='rgba(103,232,249,0.9)'; o.lineWidth=1; o.beginPath();
    o.moveTo(VW/2-7,VH/2); o.lineTo(VW/2-2,VH/2); o.moveTo(VW/2+2,VH/2); o.lineTo(VW/2+7,VH/2);
    o.moveTo(VW/2,VH/2-7); o.lineTo(VW/2,VH/2-2); o.moveTo(VW/2,VH/2+2); o.lineTo(VW/2,VH/2+7); o.stroke();
  }

  /* targeting */
  function pick(){
    updVec();
    let mx=px|0, mz=pz|0;
    const rdx=dirX, rdz=dirZ;
    const ddx=Math.abs(1/(rdx||1e-9)), ddz=Math.abs(1/(rdz||1e-9));
    let stX,stZ,sdx,sdz;
    if(rdx<0){stX=-1;sdx=(px-mx)*ddx;}else{stX=1;sdx=(mx+1-px)*ddx;}
    if(rdz<0){stZ=-1;sdz=(pz-mz)*ddz;}else{stZ=1;sdz=(mz+1-pz)*ddz;}
    let pmx=mx,pmz=mz,guard=0;
    while(guard++<40){
      let side;
      if(sdx<sdz){ pmx=mx;pmz=mz; mx+=stX; sdx+=ddx; side=0; } else { pmx=mx;pmz=mz; mz+=stZ; sdz+=ddz; side=1; }
      if(mx<0||mz<0||mx>=S||mz>=S) return null;
      const dist=side? sdz-ddz : sdx-ddx;
      if(dist>6) return null;
      const H=colH(mx,mz);
      if(H>0 && py+1.6+dist*pitchS < H) return {x:mx,z:mz,h:H,px:pmx,pz:pmz,ph:colH(pmx,pmz)};
    }
    return null;
  }
  function mine(){ const t=pick(); if(!t) return; world[idx(t.x,t.h-1,t.z)]=0; save(); }
  function place(){ const t=pick(); if(!t||t.ph>=MH) return;
    if(t.px===(px|0)&&t.pz===(pz|0)) return;
    world[idx(t.px,t.ph,t.pz)]=sel; save();
  }

  /* physics */
  function update(dt){
    updVec();
    const sp=4.5*dt; let mvx=0,mvz=0;
    if(keys.f){mvx+=dirX*sp;mvz+=dirZ*sp;}
    if(keys.b){mvx-=dirX*sp;mvz-=dirZ*sp;}
    if(keys.l){mvx+=dirZ*sp;mvz-=dirX*sp;}
    if(keys.r){mvx-=dirZ*sp;mvz+=dirX*sp;}
    const nx=px+mvx, nz=pz+mvz;
    if(nx>0.3&&nx<S-0.3&&colH(nx|0,pz|0)<=py+1.05) px=nx;
    if(nz>0.3&&nz<S-0.3&&colH(px|0,nz|0)<=py+1.05) pz=nz;
    const g=colH(px|0,pz|0);
    vy-=18*dt; py+=vy*dt;
    if(py<=g){ py=g; vy=0; grounded=true; } else grounded=false;
  }

  function loop(ts){
    raf=requestAnimationFrame(loop);
    const dt=Math.min(0.05,(ts-lastT)/1000||0.016); lastT=ts;
    if(running&&!pPaused) update(dt);
    render();
    ctx.imageSmoothingEnabled=false;
    ctx.drawImage(oc,0,0,canvas.width,canvas.height);
    if(pPaused){ ctx.fillStyle='rgba(4,7,15,0.65)'; ctx.fillRect(0,0,canvas.width,canvas.height);
      ctx.fillStyle='#22d3ee'; ctx.font='900 40px Orbitron'; ctx.textAlign='center'; ctx.fillText('PAUSED',canvas.width/2,canvas.height/2); }
  }

  /* input (assigned handlers — safe to relaunch without duplicate listeners) */
  function look(dx,dy){ yaw+=dx*0.0032; pitchS=Math.max(-0.85,Math.min(0.85,pitchS-dy*0.0022)); }
  canvas.onclick = () => {
    if (!running || pPaused) return;
    /* Pointer lock may be blocked inside sandboxed previews — never throw, fall back to drag-look. */
    try {
      const p = canvas.requestPointerLock && canvas.requestPointerLock();
      if (p && p.catch) p.catch(()=>{});
    } catch(err){ /* drag-look fallback stays active */ }
  };
  canvas.oncontextmenu = e => e.preventDefault();
  canvas.onmousedown = e => { if(!running||pPaused) return; if(e.button===0) mine(); else if(e.button===2) place(); };
  let dragging=false, lx=0, ly=0;
  /* Drag-look works for mouse AND touch whenever pointer lock is not active,
     so camera control always works even if the preview blocks pointer lock. */
  canvas.onpointerdown = e => { dragging=true; lx=e.clientX; ly=e.clientY; };
  canvas.onpointermove = e => {
    if (document.pointerLockElement === canvas){
      look(e.movementX, e.movementY);
    } else if (dragging){
      look((e.clientX-lx)*2, (e.clientY-ly)*2);
      lx=e.clientX; ly=e.clientY;
    }
  };
  canvas.onpointerup = canvas.onpointercancel = () => dragging=false;
  canvas.onpointerleave = () => dragging=false;
  /* Release pointer lock when pausing so the cursor is usable again. */
  function releaseLock(){ try { if (document.pointerLockElement === canvas && document.exitPointerLock) document.exitPointerLock(); } catch(e){} }

  function setKey(e,v){
    const k=e.key.toLowerCase();
    if(k==='w'||e.key==='ArrowUp') keys.f=v;
    else if(k==='s'||e.key==='ArrowDown') keys.b=v;
    else if(k==='a'||e.key==='ArrowLeft') keys.l=v;
    else if(k==='d'||e.key==='ArrowRight') keys.r=v;
    else if(k===' '){ if(v&&grounded) vy=6.5; }
    else if(v&&/^[1-8]$/.test(k)) setSel(+k);
    else return;
    e.preventDefault();
  }
  const bindHold=(id,fn)=>{ const el=document.getElementById(id); if(!el) return;
    el.onpointerdown=e=>{e.preventDefault();fn(1);};
    el.onpointerup=el.onpointerleave=el.onpointercancel=()=>fn(0); };
  bindHold('vm-f',v=>keys.f=v); bindHold('vm-b',v=>keys.b=v);
  bindHold('vm-l',v=>keys.l=v); bindHold('vm-r',v=>keys.r=v);
  bindHold('vm-jump',v=>{ if(v&&grounded) vy=6.5; });
  const tap=(id,fn)=>{ const el=document.getElementById(id); if(el) el.onclick=fn; };
  tap('vm-mine',mine); tap('vm-place',place);

  /* boot world */
  if(!load()) gen(seed);
  render();
  showOverlay('VOXEL SANDBOX','Explore a generated voxel island. WASD to move, mouse to look, left click mines, right click places, 1–8 picks a block, Space jumps. Your world saves automatically.','ENTER WORLD');
  raf=requestAnimationFrame(loop);

  return {
    start(){ hideOverlay(); pPaused=false; running=true; lastT=performance.now(); },
    restart(){ releaseLock(); gen((Math.random()*1e9)|0); save(); showOverlay('VOXEL SANDBOX','New world generated. Enter to explore and build.','ENTER WORLD'); running=false; pPaused=false; },
    togglePause(){ if(!running&&!pPaused) return; pPaused=!pPaused; if(pPaused){ releaseLock(); } else { running=true; lastT=performance.now(); } },
    setDir(){},
    key(e){ setKey(e,true); },
    keyup(e){ setKey(e,false); },
    stop(){ running=false; dragging=false; releaseLock(); if(raf) cancelAnimationFrame(raf); raf=null; save(); },
    get running(){ return running; }
  };
}

/* ============ POLY RUSH engine (original top-down arcade racer) ============ */
function PolyRush(){
  const W = canvas.width, H = canvas.height;
  /* closed circuit centerline (waypoints) */
  const WP = [
    [120,80],[260,60],[400,70],[520,60],[640,110],[660,220],[580,300],[440,280],[340,360],[200,400],[90,340],[70,210]
  ];
  const TRACK_W = 46, LAPS = 3;
  const CP_IDX = [0,3,6,9];              // checkpoint waypoints (0 is start/finish)
  /* ramps (boost) and barriers along the track */
  const ramps = [[640,110,40],[200,400,40],[70,210,40],[400,70,40]];
  const barriers = [
    {x:430,y:150,w:16,h:46},{x:250,y:330,w:46,h:16},{x:120,y:250,w:16,h:46},{x:560,y:170,w:16,h:46}
  ];
  const car = {x:120,y:80,a:0,v:0};
  const keys = {gas:0,brake:0,left:0,right:0,hand:0};
  let lap=1, nextCP=1, lapStart=0, raceT=0, best=store.get('bestlap',null);
  let running=false, pPaused=false, finished=false, raf=null, lastT=0, camShake=0;
  const bestEl=document.getElementById('prBest'), lapEl=document.getElementById('prLap'), timeEl=document.getElementById('prTime');

  function fmt(t){ return (t/1000).toFixed(1)+'s'; }
  function updHUD(){ lapEl.textContent = Math.min(lap,LAPS)+' / '+LAPS; timeEl.textContent = fmt(raceT); bestEl.textContent = best?fmt(best):'—'; }
  setShell(0, best?Math.round(best/10):0); updHUD();

  /* geometry helpers */
  function onTrack(x,y){
    for(let i=0;i<WP.length;i++){
      const a=WP[i], b=WP[(i+1)%WP.length];
      const dx=b[0]-a[0], dy=b[1]-a[1], L2=dx*dx+dy*dy;
      let t=((x-a[0])*dx+(y-a[1])*dy)/L2; t=Math.max(0,Math.min(1,t));
      const px=a[0]+dx*t-x, py=a[1]+dy*t-y;
      if(px*px+py*py < TRACK_W*TRACK_W) return true;
    }
    return false;
  }
  function cpHit(i,x,y){ const c=WP[CP_IDX[i]]; const dx=c[0]-x, dy=c[1]-y; return dx*dx+dy*dy < 90*90; }
  function respawn(){
    const c = WP[CP_IDX[(nextCP+CP_IDX.length-1)%CP_IDX.length]];
    const n = WP[(CP_IDX[(nextCP+CP_IDX.length-1)%CP_IDX.length]+1)%WP.length];
    car.x=c[0]; car.y=c[1]; car.v=0;
    car.a=Math.atan2(n[1]-c[1], n[0]-c[0]);
  }

  function draw(){
    ctx.save();
    if(camShake>0){ ctx.translate((Math.random()-0.5)*camShake,(Math.random()-0.5)*camShake); camShake*=0.85; }
    ctx.fillStyle='#05070d'; ctx.fillRect(-10,-10,W+20,H+20);
    /* circuit glow underlay */
    ctx.lineCap='round'; ctx.lineJoin='round';
    ctx.beginPath(); ctx.moveTo(WP[0][0],WP[0][1]);
    for(let i=1;i<=WP.length;i++) ctx.lineTo(WP[i%WP.length][0],WP[i%WP.length][1]);
    ctx.strokeStyle='rgba(34,211,238,0.25)'; ctx.lineWidth=TRACK_W*2+10; ctx.stroke();
    ctx.strokeStyle='#131a30'; ctx.lineWidth=TRACK_W*2; ctx.stroke();
    ctx.strokeStyle='rgba(103,232,249,0.55)'; ctx.lineWidth=2; ctx.setLineDash([14,12]); ctx.stroke(); ctx.setLineDash([]);
    /* start/finish line */
    const f0=WP[0], f1=WP[1];
    const fa=Math.atan2(f1[1]-f0[1],f1[0]-f0[0])+Math.PI/2;
    for(let k=-3;k<=3;k++){
      const ox=Math.cos(fa)*k*8, oy=Math.sin(fa)*k*8;
      ctx.fillStyle = (k%2===0)?'#e2e8f0':'#0b1120';
      ctx.save(); ctx.translate(f0[0]+ox,f0[1]+oy); ctx.rotate(fa); ctx.fillRect(-4,-8,8,16); ctx.restore();
    }
    /* checkpoints */
    for(let ci=1;ci<CP_IDX.length;ci++){
      const c=WP[CP_IDX[ci]], active=ci===nextCP;
      ctx.strokeStyle = active?'rgba(250,204,21,0.9)':'rgba(34,211,238,0.3)';
      ctx.lineWidth = active?4:2;
      ctx.beginPath(); ctx.arc(c[0],c[1],90,0,7); ctx.stroke();
      if(active){ ctx.fillStyle='rgba(250,204,21,0.9)'; ctx.font='900 16px Orbitron'; ctx.textAlign='center'; ctx.fillText('CP', c[0], c[1]+6); }
    }
    /* ramps */
    ramps.forEach(r=>{ ctx.fillStyle='rgba(244,114,182,0.85)'; ctx.beginPath();
      ctx.moveTo(r[0]-18,r[1]+12); ctx.lineTo(r[0]+18,r[1]+12); ctx.lineTo(r[0],r[1]-16); ctx.closePath(); ctx.fill(); });
    /* barriers */
    ctx.fillStyle='#f43f5e'; barriers.forEach(b=>{ ctx.fillRect(b.x,b.y,b.w,b.h);
      ctx.strokeStyle='rgba(244,63,94,0.5)'; ctx.strokeRect(b.x-3,b.y-3,b.w+6,b.h+6); });
    /* car */
    ctx.save(); ctx.translate(car.x,car.y); ctx.rotate(car.a);
    ctx.shadowColor='#22d3ee'; ctx.shadowBlur=12;
    ctx.fillStyle = car.v<0 ? '#94a3b8' : '#67e8f9';
    ctx.beginPath(); ctx.moveTo(14,0); ctx.lineTo(-10,-8); ctx.lineTo(-6,0); ctx.lineTo(-10,8); ctx.closePath(); ctx.fill();
    ctx.shadowBlur=0; ctx.restore();
    if(pPaused){ ctx.fillStyle='rgba(4,7,15,0.7)'; ctx.fillRect(0,0,W,H);
      ctx.fillStyle='#22d3ee'; ctx.font='900 40px Orbitron'; ctx.textAlign='center'; ctx.fillText('PAUSED',W/2,H/2); }
    ctx.restore();
  }

  function update(dt){
    if(finished) return;
    raceT += dt*1000;
    const MAXV=230, ACC=170;
    let steer = (keys.right-keys.left);
    if(keys.hand) steer *= 1.6;
    car.a += steer * 2.6 * dt * Math.min(1, Math.abs(car.v)/60);
    if(keys.gas) car.v += ACC*dt;
    else car.v -= 60*dt;
    if(keys.brake) car.v -= 260*dt;
    if(keys.hand) car.v -= 120*dt;
    car.v = Math.max(-70, Math.min(MAXV, car.v));
    if(!onTrack(car.x,car.y)) car.v *= (1-1.6*dt);
    const nx=car.x+Math.cos(car.a)*car.v*dt, ny=car.y+Math.sin(car.a)*car.v*dt;
    let crash=false;
    for(const b of barriers){
      if(nx>b.x-12&&nx<b.x+b.w+12&&ny>b.y-12&&ny<b.y+b.h+12){ crash=true; break; }
    }
    if(crash){ camShake=10; respawn(); }
    else { car.x=Math.max(10,Math.min(W-10,nx)); car.y=Math.max(10,Math.min(H-10,ny)); }
    /* ramps = boost */
    for(const r of ramps){ const dx=car.x-r[0], dy=car.y-r[1]; if(dx*dx+dy*dy<40*40 && car.v>0){ car.v=Math.min(MAXV+80,car.v+160*dt); } }
    /* checkpoints & laps */
    if(cpHit(nextCP,car.x,car.y)){
      nextCP=(nextCP+1)%CP_IDX.length;
      if(nextCP===1){
        const lapT=raceT-lapStart; lapStart=raceT;
        if(!best||lapT<best){ best=Math.round(lapT); store.set('bestlap',best); }
        lap++;
        if(lap>LAPS){
          finished=true; running=false;
          grant('racing'); grant('speed');
          const pts=Math.max(10, 2000-Math.round(raceT/10));
          const sc=store.get('scores',{}); sc['poly-rush']=Math.max(sc['poly-rush']||0,pts); store.set('scores',sc); setShell(pts,best?Math.round(best/10):0);
          showOverlay('FINISH!',`You completed ${LAPS} laps in ${fmt(raceT)} · Best lap: ${fmt(best)} · Score: ${pts}. Race again?`,'RACE AGAIN');
        }
      }
    }
    updHUD();
  }

  function loop(ts){
    raf=requestAnimationFrame(loop);
    const dt=Math.min(0.05,(ts-lastT)/1000||0.016); lastT=ts;
    if(running&&!pPaused) update(dt);
    draw();
  }

  function setKey(e,v){
    const k=e.key.toLowerCase();
    if(k==='w'||e.key==='ArrowUp') keys.gas=v;
    else if(k==='s'||e.key==='ArrowDown') keys.brake=v;
    else if(k==='a'||e.key==='ArrowLeft') keys.left=v;
    else if(k==='d'||e.key==='ArrowRight') keys.right=v;
    else if(k===' ') keys.hand=v;
    else if(v&&k==='r'){ this.restart&&this.restart(); }
    else return;
    e.preventDefault();
  }
  const hold=(id,fn)=>{ const el=document.getElementById(id); if(!el) return;
    el.onpointerdown=e=>{e.preventDefault();fn(1);};
    el.onpointerup=el.onpointerleave=el.onpointercancel=()=>fn(0); };
  hold('pr-gas',v=>keys.gas=v); hold('pr-brake',v=>keys.brake=v);
  hold('pr-left',v=>keys.left=v); hold('pr-right',v=>keys.right=v);
  hold('pr-hand',v=>keys.hand=v);

  function resetRace(){
    lap=1; nextCP=1; raceT=0; lapStart=0; finished=false; pPaused=false;
    car.x=WP[0][0]; car.y=WP[0][1]; car.v=0;
    car.a=Math.atan2(WP[1][1]-WP[0][1],WP[1][0]-WP[0][0]);
    updHUD(); draw();
  }
  resetRace();
  showOverlay('POLY RUSH','Complete 3 laps of the neon circuit. Pass checkpoints in order, hit pink ramps for boosts and avoid red barriers. Off the asphalt you lose speed!','START RACE');
  raf=requestAnimationFrame(loop);

  const api = {
    start(){ if(finished) resetRace(); hideOverlay(); pPaused=false; running=true; lastT=performance.now(); },
    restart(){ resetRace(); this.start(); },
    togglePause(){ if(!running&&!pPaused) return; pPaused=!pPaused; if(!pPaused){ running=true; lastT=performance.now(); } },
    setDir(){},
    key(e){ setKey.call(api,e,true); },
    keyup(e){ setKey.call(api,e,false); },
    stop(){ running=false; if(raf) cancelAnimationFrame(raf); raf=null; },
    get running(){ return running; }
  };
  return api;
}

/* ============ SKY RUSH engine (original 2.5D pseudo-3D tunnel flight) ============ */
function SkyRush(){
  const W = canvas.width, H = canvas.height;
  const CX = W/2, CY = H/2 - 20, HORIZON = 90;
  const F = 260;                       // focal length
  let shipY = 0, shipX = 0;            // ship offset in world units
  const keys = {up:0,down:0,left:0,right:0};
  let rings = [], obstacles = [];
  let score = 0, level = 1, ringCount = 0, ringTarget = 5, time = 30;
  let running = false, pPaused = false, over = false, raf = null, lastT = 0;
  const LVL_TIME = 30;
  const scoreEl = document.getElementById('srScore'), timeEl = document.getElementById('srTime'),
        lvlEl = document.getElementById('srLevel'), ringsEl = document.getElementById('srRings');
  function updHUD(){ scoreEl.textContent = score; timeEl.textContent = Math.max(0,time).toFixed(1)+'s';
    lvlEl.textContent = level; ringsEl.textContent = ringCount+' / '+ringTarget; }
  function spawnRing(z){ rings.push({z: z, y: (Math.random()*2-1)*1.6, x: (Math.random()*2-1)*1.6, hit:false}); }
  function spawnObs(z){ const edge = Math.random()<0.5?-1:1;
    obstacles.push({z: z, y: (Math.random()*2-1)*1.8, x: edge*(1.2+Math.random()*1.4), w: 0.7+Math.random()*0.7, hit:false}); }
  function buildLevel(){
    rings = []; obstacles = [];
    for(let i=0;i<6;i++) spawnRing(14 + i*10 + Math.random()*4);
    const n = 2 + level*2;
    for(let i=0;i<n;i++) spawnObs(10 + i*(150/(2+level)) + Math.random()*10);
  }
  function proj(z, off, plane){ return { s: F/Math.max(0.5,z), x: CX + (off - shipX*0.4)*F/Math.max(0.5,z), y: plane === 'y' ? CY - (off - shipY*0.4)*F/Math.max(0.5,z)*0.9 : 0 }; }

  function draw(){
    ctx.fillStyle = '#03101f'; ctx.fillRect(0,0,W,H);
    /* stars */
    ctx.fillStyle = 'rgba(226,232,240,0.7)';
    for(let i=0;i<40;i++){ const sx=(i*97)%W, sy=(i*53)%HORIZON; ctx.fillRect(sx,sy,1.5,1.5); }
    /* neon corridor */
    ctx.strokeStyle = 'rgba(34,211,238,0.25)'; ctx.lineWidth = 2;
    for(let i=0;i<10;i++){
      const z = 2 + ((i*20 + (performance.now()/40)%20) % 200);
      const p = proj(z, -3.2, 'x');
      const p2 = proj(z, 3.2, 'x');
      const yb = CY + (3.2 + shipY*0.4)*F/Math.max(0.5,z)*0.9;
      ctx.globalAlpha = Math.min(1, 2.5/z);
      ctx.beginPath(); ctx.moveTo(p.x, HORIZON + (yb-HORIZON)*0); ctx.moveTo(p.x, yb); ctx.lineTo(p2.x, yb); ctx.stroke();
    }
    ctx.globalAlpha = 1;
    /* rings */
    rings.sort((a,b)=>b.z-a.z).forEach(r => {
      if(r.z < 0.5 || r.z > 60) return;
      const s = F/r.z, rx = 26*s, ry = 34*s;
      const cx = CX + (r.x - shipX*0.4)*s, cy = CY - (r.y - shipY*0.4)*s*0.9;
      ctx.strokeStyle = r.hit ? 'rgba(52,211,153,0.5)' : '#f59e0b';
      ctx.lineWidth = r.hit ? 3 : 5;
      ctx.shadowColor = '#f59e0b'; ctx.shadowBlur = r.hit ? 0 : 12;
      ctx.beginPath(); ctx.ellipse(cx, cy, Math.max(1,rx), Math.max(1,ry), 0, 0, 7); ctx.stroke();
      ctx.shadowBlur = 0;
    });
    /* obstacles (pylons) */
    obstacles.forEach(o => {
      if(o.z < 0.5 || o.z > 60) return;
      const s = F/o.z, w = o.w*s;
      const cx = CX + (o.x - shipX*0.4)*s, cy = CY - (o.y - shipY*0.4)*s*0.9;
      ctx.fillStyle = '#475569'; ctx.strokeStyle = 'rgba(148,163,184,0.5)';
      ctx.fillRect(cx-w/2, cy-w, w, w*3); ctx.strokeRect(cx-w/2, cy-w, w, w*3);
    });
    /* ship */
    const shx = CX + shipX*10, shy = CY - shipY*10*0.9;
    ctx.shadowColor = '#22d3ee'; ctx.shadowBlur = 14;
    ctx.fillStyle = '#67e8f9';
    ctx.beginPath(); ctx.moveTo(shx, shy-14); ctx.lineTo(shx+13, shy+10); ctx.lineTo(shx, shy+4); ctx.lineTo(shx-13, shy+10); ctx.closePath(); ctx.fill();
    ctx.shadowBlur = 0;
    /* engine flame */
    ctx.fillStyle = 'rgba(59,130,246,0.8)';
    const fl = 8 + Math.sin(performance.now()/40)*3;
    ctx.beginPath(); ctx.moveTo(shx-5, shy+5); ctx.lineTo(shx, shy+5+fl); ctx.lineTo(shx+5, shy+5); ctx.closePath(); ctx.fill();
    if(pPaused){ ctx.fillStyle='rgba(4,7,15,0.7)'; ctx.fillRect(0,0,W,H);
      ctx.fillStyle='#22d3ee'; ctx.font='900 40px Orbitron'; ctx.textAlign='center'; ctx.fillText('PAUSED',W/2,H/2); }
  }

  function update(dt){
    if(over) return;
    const spd = (16 + level*2) * dt;
    /* scroll world toward ship */
    rings.forEach(r => r.z -= spd);
    obstacles.forEach(o => o.z -= spd);
    /* steering */
    const st = 3.4*dt;
    if(keys.up) shipY = Math.min(2.4, shipY + st);
    if(keys.down) shipY = Math.max(-2.4, shipY - st);
    if(keys.left) shipX = Math.max(-2.8, shipX - st);
    if(keys.right) shipX = Math.min(2.8, shipX + st);
    /* timer */
    time -= dt;
    if(time <= 0) return gameOver(false);
    /* ring collisions */
    rings.forEach(r => {
      if(!r.hit && r.z < 1.2 && r.z > -0.5){
        if(Math.abs(r.x - shipX) < 1.1 && Math.abs(r.y - shipY) < 1.1){
          r.hit = true; score += 100; ringCount++;
          if(ringCount >= ringTarget) return levelUp();
        }
      }
    });
    /* obstacle collisions */
    for(const o of obstacles){
      if(o.z < 1.2 && o.z > -0.5){
        if(Math.abs(o.x - shipX) < o.w*0.7 + 0.35 && Math.abs(o.y - shipY) < 0.6){
          return gameOver(true);
        }
      }
    }
    /* recycle offscreen */
    rings = rings.filter(r => r.z > -1);
    obstacles = obstacles.filter(o => o.z > -1);
    if(rings.filter(r=>!r.hit).length < 4){ let maxZ = Math.max(10, ...rings.map(r=>r.z)); spawnRing(maxZ + 8 + Math.random()*6); }
    if(obstacles.length < 2 + level){ let maxZ = Math.max(10, ...obstacles.map(o=>o.z)); spawnObs(maxZ + 6 + Math.random()*8); }
    updHUD();
  }
  function levelUp(){
    grant('speed');
    level++; ringCount = 0; ringTarget = 4 + level; time = LVL_TIME;
    const sc = store.get('scores',{}); sc['sky-rush'] = Math.max(sc['sky-rush']||0, score); store.set('scores', sc);
    setShell(score, sc['sky-rush']);
    buildLevel();
    toastish('LEVEL ' + level + ' — target: ' + ringTarget + ' rings!');
  }
  let toastT;
  function toastish(msg){ ctx.fillStyle='rgba(4,7,15,0.75)'; ctx.fillRect(0,H/2-34,W,54);
    ctx.fillStyle='#f59e0b'; ctx.font='900 24px Orbitron'; ctx.textAlign='center'; ctx.fillText(msg, W/2, H/2); }
  function gameOver(crashed){
    over = true; running = false;
    const sc = store.get('scores',{}); sc['sky-rush'] = Math.max(sc['sky-rush']||0, score); store.set('scores', sc);
    setShell(score, sc['sky-rush']);
    showOverlay(crashed ? 'CRASHED!' : 'OUT OF TIME', `Flight over at level ${level} with ${score} points. Fly again?`, 'FLY AGAIN');
  }
  function loop(ts){
    raf = requestAnimationFrame(loop);
    const dt = Math.min(0.05,(ts-lastT)/1000||0.016); lastT = ts;
    if(running && !pPaused) update(dt);
    draw();
  }
  function setKey(e,v){
    const k = e.key.toLowerCase();
    if(k==='w'||e.key==='ArrowUp') keys.up = v;
    else if(k==='s'||e.key==='ArrowDown') keys.down = v;
    else if(k==='a'||e.key==='ArrowLeft') keys.left = v;
    else if(k==='d'||e.key==='ArrowRight') keys.right = v;
    else return;
    e.preventDefault();
  }
  const hold = (id,fn) => { const el = document.getElementById(id); if(!el) return;
    el.onpointerdown = e => { e.preventDefault(); fn(1); };
    el.onpointerup = el.onpointerleave = el.onpointercancel = () => fn(0); };
  hold('sr-up',v=>keys.up=v); hold('sr-down',v=>keys.down=v);
  hold('sr-left',v=>keys.left=v); hold('sr-right',v=>keys.right=v);

  function resetFlight(){
    score = 0; level = 1; ringCount = 0; ringTarget = 5; time = LVL_TIME;
    shipX = 0; shipY = 0; over = false; pPaused = false;
    buildLevel(); updHUD(); draw();
  }
  resetFlight();
  const high0 = store.get('scores',{})['sky-rush'] || 0;
  setShell(0, high0);
  showOverlay('SKY RUSH','Fly through every golden energy ring before time runs out. Dodge grey pylons — one collision ends the flight. Each level raises the ring target and adds obstacles!','START FLIGHT');
  raf = requestAnimationFrame(loop);

  return {
    start(){ if(over) resetFlight(); hideOverlay(); pPaused = false; running = true; lastT = performance.now(); },
    restart(){ resetFlight(); this.start(); },
    togglePause(){ if(!running && !pPaused) return; pPaused = !pPaused; if(!pPaused){ running = true; lastT = performance.now(); } },
    setDir(){},
    key(e){ setKey(e,true); },
    keyup(e){ setKey(e,false); },
    stop(){ running = false; if(raf) cancelAnimationFrame(raf); raf = null; },
    get running(){ return running; }
  };
}

/* Input */
document.addEventListener('keydown', e => {
  if (currentPage !== 'play' || !currentGame) return;
  if (currentGame.key){
    if(e.key.toLowerCase()==='p'){ e.preventDefault(); currentGame.togglePause(); }
    else if (!currentGame.running && !currentGame.pPaused) { /* keys accepted once running */ currentGame.key(e); }
    else currentGame.key(e);
    return;
  }
  const map = {ArrowUp:'up',ArrowDown:'down',ArrowLeft:'left',ArrowRight:'right',w:'up',s:'down',a:'left',d:'right'};
  const k = map[e.key] || map[e.key.toLowerCase()];
  if (k){ e.preventDefault(); if (!currentGame.running && !paused) currentGame.start(); else currentGame.setDir(k); }
});
document.addEventListener('keyup', e => {
  if (currentPage === 'play' && currentGame && currentGame.keyup) currentGame.keyup(e);
});
document.querySelectorAll('.touch-btn').forEach(b => b.addEventListener('click', () => { if (!currentGame) return; if (!currentGame.running) currentGame.start(); currentGame.setDir(b.dataset.dir); }));
let tsx=0, tsy=0;
canvas.addEventListener('touchstart', e => { tsx = e.touches[0].clientX; tsy = e.touches[0].clientY; }, {passive:true});
canvas.addEventListener('touchend', e => {
  if (!currentGame) return;
  const dx = e.changedTouches[0].clientX - tsx, dy = e.changedTouches[0].clientY - tsy;
  if (Math.abs(dx) < 20 && Math.abs(dy) < 20) return;
  currentGame.setDir(Math.abs(dx) > Math.abs(dy) ? (dx>0?'right':'left') : (dy>0?'down':'up'));
}, {passive:true});

/* Boot — run once the DOM is ready; a storage/UI error can never kill the app */
function boot(){
  try { syncHearts(); } catch(err){ console.error('syncHearts error:', err); }
  try { applyFilters(); } catch(err){ console.error('applyFilters error:', err); }
  try { renderLoginState(); } catch(err){ console.error('renderLoginState error:', err); }
  try { go('home'); } catch(err){ console.error(err); show('home'); }
}
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
else boot();
</script>
</body>
</html>
