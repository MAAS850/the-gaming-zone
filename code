<script>
/* ============ Utilities & local data layer ============ */
/* Safe storage: never throws, in-memory fallback if storage is blocked */
const _mem = {};
const _safeLS = {
  getItem(k){ try { return localStorage.getItem(k); } catch(e){ return _mem[k] ?? null; } },
  setItem(k,v){ try { localStorage.setItem(k,v); } catch(e){ _mem[k] = v; } },
  removeItem(k){ try { localStorage.removeItem(k); } catch(e){ delete _mem[k]; } }
};
const _safeSS = {
  getItem(k){ try { return sessionStorage.getItem(k); } catch(e){ return null; } },
  setItem(k,v){ try { sessionStorage.setItem(k,v); } catch(e){} }
};
const store = {
  get(k, d){ try{ return JSON.parse(_safeLS.getItem('tgz_'+k)) ?? d }catch(e){ return d } },
  set(k, v){ try { _safeLS.setItem('tgz_'+k, JSON.stringify(v)) }catch(e){} }
};
let favs = store.get('favs', []);

/* Centralized game data */
const GAMES = {
