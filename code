  .neon-text{text-shadow:0 0 14px rgba(34,211,238,.6)}
  .card-glow{transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease}
  .card-glow:hover{transform:translateY(-4px);border-color:rgba(34,211,238,.6);box-shadow:0 0 22px rgba(34,211,238,.25)}
  .btn-neon{background:linear-gradient(90deg,#0891b2,#2563eb);transition:box-shadow .2s ease,filter .2s ease}
  .btn-neon:hover{box-shadow:0 0 22px rgba(34,211,238,.5);filter:brightness(1.1)}
  .grid-bg{background-image:linear-gradient(rgba(34,211,238,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(34,211,238,.05) 1px,transparent 1px);background-size:44px 44px}
  .page{display:none;animation:fadein .35s ease}
  .page.active{display:block}
  @keyframes fadein{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  .heart-btn.fav svg{fill:#f43f5e;stroke:#f43f5e}
  canvas{touch-action:none}
  ::selection{background:#22d3ee;color:#05070d}
</style>
